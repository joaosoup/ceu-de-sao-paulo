{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] } },
    { "name": "assets", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/icons/**"] } }
  ],
  "dataGroups": [
    { "name": "eventos", "urls": ["/api/cells/**"], "cacheConfig": { "strategy": "freshness", "maxSize": 10, "maxAge": "12h", "timeout": "4s" } }
  ]
}
