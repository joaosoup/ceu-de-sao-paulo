{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceu-de-sao-paulo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // A PWA compilada. Tudo que não for /api cai no index.html.
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // Troque database_id pelo valor que `wrangler d1 create ceu-db` imprimir.
    { "binding": "DB", "database_name": "ceu-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "queues": {
    "producers": [
      { "binding": "PRECOMPUTE_QUEUE", "queue": "ceu-precompute" },
      { "binding": "SEND_QUEUE", "queue": "ceu-send" }
    ],
    "consumers": [
      // 1 mensagem por execução: cada tarefa precisa caber em 10 ms de CPU (ADR 0003).
      { "queue": "ceu-precompute", "max_batch_size": 1, "max_retries": 2 },
      { "queue": "ceu-send", "max_batch_size": 1, "max_retries": 1 }
    ]
  },
  "triggers": {
    // 1) todo minuto: decide alertas e libera envios. 2) duas vezes ao dia: elementos + pré-cálculo.
    "crons": ["* * * * *", "17 3,15 * * *"]
  },
  "vars": {
    "VAPID_SUBJECT": "mailto:troque-por-seu-contato@example.com"
  }
  // Segredos (wrangler secret put): VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY, ADMIN_TOKEN
  // Opcionais: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
}
